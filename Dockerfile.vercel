FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

RUN apt-get update && apt-get install -y zip unzip \
    && install-php-extensions zip pdo_mysql

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY . .

RUN composer install --no-dev --optimize-autoloader

# Pastikan folder penting ada dan beri izin akses penuh
RUN mkdir -p storage/framework/views storage/framework/sessions storage/framework/cache storage/logs bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache

# Buka akses untuk file statis seperti favicon.ico
ENV FRANKENPHP_CONFIG="web_root public/"

CMD ["sh", "-c", "php artisan config:clear && php-server --listen :${PORT:-8000} --root public/"]
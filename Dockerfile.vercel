FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

# Instal dependensi sistem dan ekstensi PHP
RUN apt-get update && apt-get install -y zip unzip \
    && install-php-extensions zip pdo_mysql

# Salin Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Salin seluruh kode proyek
COPY . .

# Instal dependensi Composer
RUN composer install --no-dev --optimize-autoloader

# Buat folder direktori dan atur izin akses
RUN mkdir -p storage/framework/views storage/framework/sessions storage/framework/cache storage/logs bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache

# Konfigurasi FrankenPHP
ENV FRANKENPHP_CONFIG="web_root public/"

# Jalankan clearing cache Laravel lalu start server FrankenPHP
CMD ["sh", "-c", "php artisan config:clear && frankenphp php-server --listen :${PORT:-8000} --root public/"]